{
  "args": {
    "crop_w": {
      "desc": "Width/height of crop box (always square)",
      "required": true,
      "type": "string"
    },
    "crop_x": {
      "desc": "X coordinate of top-left corner of crop box",
      "required": true,
      "type": "string"
    },
    "crop_y": {
      "desc": "Y coordinate of top-left corner of crop box",
      "required": true,
      "type": "string"
    },
    "image": {
      "desc": "File contents via `multipart/form-data`.",
      "required": true,
      "type": "string"
    },
    "token": {
      "desc": "Authentication token. Requires scope: `users.profile:write`",
      "required": true,
      "type": "string"
    }
  },
